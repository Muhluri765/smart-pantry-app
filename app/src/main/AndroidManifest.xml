<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Smart Pantry"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryApp">

        <!-- Screen 1: Main Pantry Dashboard (Launch Activity) -->
        <activity
            android:name=".PantryListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Add / Edit Ingredient Form -->
        <activity
            android:name=".AddEditIngredientActivity"
            android:exported="false"
            android:parentActivityName=".PantryListActivity" />

        <!-- Screen 3: Suggested Recipes List -->
        <activity
            android:name=".SuggestedRecipesActivity"
            android:exported="false"
            android:parentActivityName=".PantryListActivity" />

        <!-- Screen 4: Recipe Details -->
        <activity
            android:name=".RecipeDetailActivity"
            android:exported="false"
            android:parentActivityName=".SuggestedRecipesActivity" />

        <!-- Screen 5: Settings Preferences -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".PantryListActivity" />

    </application>

</manifest>
