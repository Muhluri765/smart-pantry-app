<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme targeting light mode with high-contrast text -->
    <style name="Theme.SmartPantryApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryVariant">#1B5E20</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#FF8F00</item>
        <item name="colorSecondaryVariant">#C56000</item>
        <item name="colorOnSecondary">#000000</item>

        <!-- Background & Surface Colors -->
        <item name="android:colorBackground">#F8F9FA</item>
        <item name="colorSurface">#FFFFFF</item>

        <!-- Default Text Colors across all Activities -->
        <item name="android:textColor">#212121</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:textColorSecondary">#616161</item>
        <item name="android:textColorHint">#9E9E9E</item>

        <!-- Edit Form / Widget Controls -->
        <item name="android:editTextColor">#212121</item>
    </style>
</resources>
